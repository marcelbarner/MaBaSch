<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0">
        <Configuration>
          <CodeCoverage>
            <!-- EF Core migrations are generated scaffolding, not hand-written logic;
                 excluding them keeps the coverage number meaningful for code we actually
                 review and maintain. -->
            <Functions>
              <Exclude>
                <Function>^MaBaSch\.Migrations\..*</Function>
                <!-- Source-generator output compiled into our own assembly (ASP.NET Core
                     OpenAPI generator, compiler-synthesized helpers) - not hand-written
                     application code, so it shouldn't count against the coverage gate. -->
                <Function>^Microsoft\.AspNetCore\.OpenApi\.Generated\..*</Function>
                <Function>^System\.Runtime\.CompilerServices\..*</Function>
              </Exclude>
            </Functions>
            <ExcludeCompilerAutoGeneratedModules>True</ExcludeCompilerAutoGeneratedModules>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
